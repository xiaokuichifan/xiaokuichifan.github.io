---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---

<BaseLayout title="文章" description="全部技术笔记，按时间倒序。">
  <h1 class="page-title">文章</h1>
  <p class="page-intro">按时间倒序。草稿只在本地预览时出现。</p>

  {
    posts.length === 0 ? (
      <p class="empty">还没有公开的文章。</p>
    ) : (
      years.map((year) => (
        <section class="year-block">
          <h2>{year}</h2>
          <div class="post-list">
            {posts
              .filter((post) => post.data.date.getUTCFullYear() === year)
              .map((post) => (
                <PostCard post={post} heading="h3" />
              ))}
          </div>
        </section>
      ))
    )
  }
</BaseLayout>
