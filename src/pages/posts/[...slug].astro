---
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { adjacentPosts, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const { newer, older } = adjacentPosts(posts, post.id);
    return {
      params: { slug: post.id },
      props: { post, newer, older },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} newer={newer} older={older}>
  <Content />
</PostLayout>
