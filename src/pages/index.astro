---
import BaseLayout from "../layouts/BaseLayout.astro";
import Avatar from "../components/Avatar.astro";
import CoverMark from "../components/CoverMark.astro";
import PostCard from "../components/PostCard.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import ProjectList from "../components/ProjectList.astro";
import TagCloud from "../components/TagCloud.astro";
import TopicGrid from "../components/TopicGrid.astro";
import { getPublishedPosts, getTagCounts, selectFeatured } from "../lib/posts";
import { isPlaceholder } from "../lib/text";
import { site } from "../site.config";

const posts = await getPublishedPosts();
const featured = selectFeatured(posts);
const rest = featured
  ? posts.filter((post) => post.id !== featured.post.id).slice(0, site.recentPostCount)
  : [];
const tags = getTagCounts(posts);
const handle = site.profiles.find((item) => item.handle);
const handleExternal = handle ? /^https?:\/\//i.test(handle.href) : false;
---

<BaseLayout>
  <header class="masthead">
    <div class="hero-copy">
      <div class="identity">
        <Avatar />
        <div>
          <p class="kicker">{site.author}</p>
          {
            handle && (
              <p class="identity-handle">
                <a
                  href={handle.href}
                  target={handleExternal ? "_blank" : undefined}
                  rel={handleExternal ? "noopener noreferrer" : undefined}
                >
                  {handle.handle}
                  {handleExternal && <span class="visually-hidden">（新窗口打开）</span>}
                </a>
              </p>
            )
          }
        </div>
      </div>
      <h1>{site.title}</h1>
      <p class="lede">{site.description}</p>
      {
        site.heroNote && (
          <p class:list={["hero-note", { placeholder: isPlaceholder(site.heroNote) }]}>
            {site.heroNote}
          </p>
        )
      }
      <ProfileLinks />
    </div>
    <div class="hero-art" aria-hidden="true">
      <CoverMark seed="site-hero" variant="hero" />
    </div>
  </header>

  <section class="band" aria-labelledby="topics-title">
    <div class="section-head">
      <h2 id="topics-title">研究关注</h2>
    </div>
    <TopicGrid posts={posts} />
  </section>

  <section class="band" aria-labelledby="notes-title">
    <div class="section-head">
      <h2 id="notes-title">笔记</h2>
      <a href="/posts/">全部文章</a>
    </div>
    {
      featured ? (
        <>
          <PostCard
            post={featured.post}
            heading="h3"
            featured
            kicker={featured.pinned ? "置顶" : "最新"}
          />
          {rest.length > 0 && (
            <div class="card-grid">
              {rest.map((post) => (
                <PostCard post={post} heading="h3" />
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="empty">还没有公开的文章。</p>
      )
    }
  </section>

  <section class="band" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">项目</h2>
      <a href="/projects/">全部项目</a>
    </div>
    <ProjectList heading="h3" />
  </section>

  {
    tags.length > 0 && (
      <section class="band" aria-labelledby="tags-title">
        <div class="section-head">
          <h2 id="tags-title">标签</h2>
          <a href="/tags/">全部标签</a>
        </div>
        <TagCloud tags={tags} />
      </section>
    )
  }
</BaseLayout>
