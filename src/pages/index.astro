---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";
import { site } from "../site.config";

const posts = (await getPublishedPosts()).slice(0, site.recentPostCount);
---

<BaseLayout>
  <header class="masthead">
    <p class="kicker">{site.author}</p>
    <h1>{site.title}</h1>
    <p class="lede">{site.description}</p>
    <ul class="topic-row">
      {site.topics.map((topic) => <li>{topic.name}</li>)}
    </ul>
  </header>

  <div class="section-head">
    <h2>最近</h2>
    <a href="/posts/">全部文章</a>
  </div>

  {
    posts.length === 0 ? (
      <p class="empty">还没有公开的文章。</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</BaseLayout>
