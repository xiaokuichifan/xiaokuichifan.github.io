---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectList from "../../components/ProjectList.astro";
import { isPlaceholder } from "../../lib/text";
import { site } from "../../site.config";
---

<BaseLayout
  title="项目"
  description={site.projects.length > 0 ? `${site.author} 在做的项目。` : site.projectsEmpty}
>
  <h1 class="page-title">项目</h1>
  {
    site.projects.length === 0 ? (
      site.projectsEmpty && <p class="page-intro">{site.projectsEmpty}</p>
    ) : (
      <>
        {site.projectsIntro && (
          <p class:list={["page-intro", { placeholder: isPlaceholder(site.projectsIntro) }]}>
            {site.projectsIntro}
          </p>
        )}
        <ProjectList heading="h2" />
      </>
    )
  }
</BaseLayout>
