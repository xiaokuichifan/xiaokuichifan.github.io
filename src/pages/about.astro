---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout title="关于" description={`${site.author}：${site.description}`}>
  <p class="kicker">关于</p>
  <h1 class="page-title">{site.author}</h1>
  <div class="prose">
    {site.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <dl class="about-topics">
    {
      site.topics.map((topic) => (
        <div>
          <dt>{topic.name}</dt>
          <dd>{topic.detail}</dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>
