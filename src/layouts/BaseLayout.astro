---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}

const { title, description = site.description, ogType = "website" } = Astro.props;
const documentTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.locale} data-theme="light">
  <head>
    <BaseHead title={documentTitle} description={description} ogType={ogType} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#141311" : "#f4f1ea");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
