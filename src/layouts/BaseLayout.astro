---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Intro from "../components/Intro.astro";
import { serializeJsonLd, websiteJsonLd } from "../lib/seo";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: string;
  tags?: readonly string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  ogType = "website",
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  publishedTime,
  tags,
  noindex = false,
  jsonLd,
} = Astro.props;
const documentTitle = title ? `${title} · ${site.title}` : site.title;
const pathname = Astro.url.pathname.replace(/\/index\.html$/, "/");
const isHome = pathname === "/" || pathname === "";
const structured = jsonLd ?? (isHome ? websiteJsonLd() : undefined);
---

<!doctype html>
<html lang={site.locale} data-theme="light">
  <head>
    <BaseHead
      title={documentTitle}
      description={description}
      ogType={ogType}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      publishedTime={publishedTime}
      tags={tags}
      noindex={noindex}
      jsonLd={structured ? serializeJsonLd(structured) : undefined}
    />
    <Analytics />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#141311" : "#f4f1ea");
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (sessionStorage.getItem("kui-intro-seen") === "1") return;
          sessionStorage.setItem("kui-intro-seen", "1");
          document.documentElement.classList.add("intro-on");
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      .intro { display: none; }
      html.intro-on .intro {
        display: grid;
        place-items: center;
        position: fixed;
        inset: 0;
        z-index: 40;
        overflow: hidden;
        background: var(--bg, #f4f1ea);
        color: var(--text, #1f1a17);
      }
      @media (prefers-reduced-motion: reduce) {
        .intro { display: none !important; }
      }
    </style>
  </head>
  <body>
    <Intro />
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
