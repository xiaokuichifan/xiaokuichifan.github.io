<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="切换深色模式"
  aria-pressed="false"
>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="currentColor"
      d="M14.5 3.1a8.8 8.8 0 1 0 6.4 14.2A8.2 8.2 0 0 1 14.5 3.1z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"
      ></path>
    </g>
  </svg>
</button>

<script>
  const button = document.getElementById("theme-toggle");
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  function paint(theme: string) {
    document.documentElement.dataset.theme = theme;
    button?.setAttribute("aria-pressed", String(theme === "dark"));
    button?.setAttribute("aria-label", theme === "dark" ? "切换到浅色模式" : "切换到深色模式");
    themeMeta?.setAttribute("content", theme === "dark" ? "#141311" : "#f4f1ea");
  }

  paint(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("theme", next);
    paint(next);
  });
</script>
