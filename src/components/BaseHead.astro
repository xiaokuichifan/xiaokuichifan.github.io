---
import { absoluteUrl } from "../lib/seo";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: string;
  tags?: readonly string[];
  noindex?: boolean;
  jsonLd?: string;
}

const {
  title,
  description,
  ogType = "website",
  image = "/og.png",
  imageAlt,
  imageWidth,
  imageHeight,
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const rss = new URL("/rss.xml", Astro.site ?? site.url);
const imageUrl = absoluteUrl(image);
const alt = imageAlt || title;
const generated = image === "/og.png" || image.startsWith("/og/");
const width = imageWidth ?? (generated ? 1200 : undefined);
const height = imageHeight ?? (generated ? 630 : undefined);
const authorUrl = site.profiles.find((item) => item.label === "GitHub")?.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={site.title} href={rss} />
<meta name="author" content={site.author} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  site.googleSiteVerification && (
    <meta name="google-site-verification" content={site.googleSiteVerification} />
  )
}
{
  site.bingSiteVerification && (
    <meta name="msvalidate.01" content={site.bingSiteVerification} />
  )
}
<meta name="theme-color" content="#f4f1ea" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content={site.title} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={alt} />
{generated && <meta property="og:image:type" content="image/png" />}
{width && <meta property="og:image:width" content={String(width)} />}
{height && <meta property="og:image:height" content={String(height)} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={alt} />
{
  ogType === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{ogType === "article" && authorUrl && <meta property="article:author" content={authorUrl} />}
{ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;700&display=swap"
  rel="stylesheet"
/>
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
